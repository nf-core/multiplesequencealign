nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test_tiny") {

        when {
            params {
                config_profile_name        = 'Test profile'
                config_profile_description = 'Tiny test dataset to check pipeline function'
                skip_stats      = false
                calc_sim        = true
                calc_seq_stats  = true
                extract_plddt   = true
                skip_eval       = false
                calc_sp         = true
                calc_tc         = true
                calc_irmsd      = true
                calc_gaps       = true
                calc_tcs        = true
                build_consensus = true


                // Define your base URL here
                pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/multiplesequencealign'

                // Now you can use the variable
                input = "${params.pipelines_testdata_base_path}/samplesheet/v1.1/samplesheet_test_af2.csv"
                tools = "${params.pipelines_testdata_base_path}/toolsheet/v1.1/toolsheet_tiny.csv"

                outdir = "results"
            }
        }

        then {

            assertAll(
                { assert workflow.success},
            )
        }
    }
}
