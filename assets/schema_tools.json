{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/msa/master/assets/schema_tools.json",
    "title": "nf-core/msa pipeline - params.tools schema",
    "description": "Schema for the file provided with params.tools",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "tree": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "tree name cannot contain spaces and must be a string",
                "meta": ["tree"],
                "default": ""
            },
            "args_tree": {
                "type": "string",
                "meta": ["args_tree"],
                "default": ""
            },
            "aligner": {
                "type": "string",
                "meta": ["aligner"],
                "pattern": "^\\S+$",
                "enum": [
                    "CLUSTALO",
                    "FAMSA",
                    "KALIGN",
                    "LEARNMSA",
                    "MAFFT",
                    "MAGUS",
                    "MUSCLE5",
                    "TCOFFEE",
                    "REGRESSIVE",
                    "UPP",
                    "3DCOFFEE",
                    "MTMALIGN",
                    "FOLDMASON"
                ],
                "errorMessage": "align name must be provided, has to be a string, cannot contain spaces and must be one of: CLUSTALO, FAMSA, KALIGN, LEARNMSA, MAFFT, MAGUS, MUSCLES, TCOFFEE, REGRESSIVE, UPP, 3DCOFFE, MTMALIGN or FOLDMASON",
                "default": ""
            },
            "args_aligner": {
                "type": "string",
                "meta": ["args_aligner"],
                "default": ""
            }
        },
        "required": ["aligner"]
    }
}
